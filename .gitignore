*.pdb
*.pdbqt
*.sdf
*.mol2

# Tabular data
*.csv
*.xlsx
*.tsv
runs_registry.csv

# ============================================
# External Tools & Dependencies
# ============================================
DiffDock/
Diffdock/
benchmark_tools/

# ============================================
# Generated Outputs
# ============================================
