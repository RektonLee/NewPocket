*.png
*.jpg
*.jpeg
*.svg
*.pdf
!paperwriting/gemini.pdf
!paperwriting/figures/*.pdf
!paperwriting/figures/*.png

# Figures directory (except README)
figures/*
!figures/README.md
!figures/archived/README.md

# ============================================
# Logs & Temporary Files
# ============================================
logs/
tmp/
*.log
*.out
*.err

# LaTeX auxiliary files
*.aux
*.synctex.gz
*.bbl
*.blg
*.fls
*.fdb_latexmk

