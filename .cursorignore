# Cursor Ignore
# 忽略数据目录，避免 AI 索引大量数据文件导致卡顿或上下文污染

# 数据目录
data/
results/
outputs/
output/
sample_data/
experiments/

# 日志和临时文件
logs/
tmp/
*.log
*.out
*.err

# 外部工具目录（通常很大且不需要索引）
DiffDock/
benchmark_tools/

# 模型文件和检查点
*.pt
*.pth
*.ckpt
*.pkl
*.pickle

# 结构文件（PDB等）
*.pdb
*.pdbqt
*.sdf
*.mol2

# 数据文件
*.csv
*.xlsx
*.h5
*.hdf5

# 生成的图片和图表
*.png
*.jpg
*.jpeg
*.pdf
*.svg

# 版本控制和缓存
.git/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 环境
.venv/
venv/
env/
wandb/

# 笔记本输出（保留代码但忽略输出）
notebooks/*.ipynb
